# DocuMind AI — Environment Configuration Template
# Copy this file to .env and configure your values:
#   cp .env.example .env
# NEVER commit your real .env file.

# =====================================================================
# 1. ADMIN AUTHORIZATION GATE
# =====================================================================
# Secret key required to access /admin portal, upload, and delete PDFs.
# Client sends this via the 'X-Admin-Key' HTTP header.
SUPER_USER_KEY=supersecretkey

# =====================================================================
# 2. INFERENCE PROVIDER CONFIGURATION
# =====================================================================
# Choose between:
#   - "ollama"            : 100% private, offline inference on Mac Apple Silicon
#   - "openai_compatible" : Cloud inference via Groq, Together, OpenRouter, etc.
LLM_PROVIDER=ollama

# --- Option A: Local Native Ollama (Recommended for MacBook Air M4) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# --- Option B: Hosted Cloud Inference (e.g., Groq) ---
# To use Groq, set LLM_PROVIDER=openai_compatible and provide your free key:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# =====================================================================
# 3. EMBEDDINGS & VECTOR STORAGE PERSISTENCE
# =====================================================================
# Sentence-Transformers local embedding model (384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Persistent directories on local filesystem (survives app restarts)
PERSIST_DIR=./db
PDF_DIR=./data

# Maximum allowed PDF upload size in megabytes
MAX_UPLOAD_SIZE_MB=20
