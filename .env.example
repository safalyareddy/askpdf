# DocuMind AI — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your real .env file.

# Admin / Super User Key for Document Upload & Deletion
# Minimum 16 characters recommended for production
SUPER_USER_KEY=documind-dev-supersecretkey-change-in-prod

# LLM Provider Configuration
# Options: "ollama" (local or remote Ollama server) or "openai_compatible" (Groq, Together, OpenRouter, OpenAI)
LLM_PROVIDER=ollama

# --- Option A: For Ollama (Local macOS or Remote Ollama Server) ---
# Local host: http://localhost:11434
# Docker on macOS: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# --- Option B: For Cloud / Render Deployment (Free Hosted Inference) ---
# Uncomment and set these on Render or in production:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.1-8b-instant

# Storage & File Limits
# On Render with Persistent Disk mounted at /var/data, set:
# PDF_DIR=/var/data/pdfs
# PERSIST_DIR=/var/data/chroma
PERSIST_DIR=./db
PDF_DIR=./data/
MAX_UPLOAD_SIZE_MB=20
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
