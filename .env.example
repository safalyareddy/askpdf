# DocuMind AI — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your real .env file.

# Admin / Super User Key for Document Upload & Deletion
# Minimum 16 characters recommended for production
SUPER_USER_KEY=documind-dev-supersecretkey-change-in-prod

# Ollama Endpoint
# Local macOS host: http://localhost:11434
# Inside Docker on macOS: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# LLM & Embedding Models
LLM_MODEL=llama3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Storage & File Limits
PERSIST_DIR=./db
PDF_DIR=./data/
MAX_UPLOAD_SIZE_MB=20
